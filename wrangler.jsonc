{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "urban-procure",
  "compatibility_date": "2026-08-29",
  "pages_build_output_dir": "dist",
  "d1_databases": [
    {
      "binding": "URBAN_PROCURE_DB",
      "database_name": "urban-procure-db",
      "database_id": "15f861d6-4a86-445e-b56a-66d1b3bc04ba"
    }
  ],
  "r2_buckets": [
    {
      "binding": "URBAN_PROCURE_RFQ_DOCUMENTS",
